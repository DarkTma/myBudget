<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:elevation="10dp"
    android:padding="0dp"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/dimLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#99000000"
        android:clickable="true"/>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/menuLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/my_darkbg"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="10dp"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Меню"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnincomeData"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Доходы"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnLastMonths"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Данные по месецам"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp"
            android:tint="@android:color/white" />

        <Button
            android:id="@+id/btnMonthlySpents"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="регулярные расходы"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnCategories"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Категории"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnCurs"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Валюты"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnMaketGo"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Шаблоны"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp"
            android:tint="@android:color/white"
            />

        <Button
            android:id="@+id/btnGrafGo"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Графики"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnGoalGo"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Накопления"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnGeminiGo"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Асистент myBudget"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/buttonHistory"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="История"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp"
            />


        <Button
            android:id="@+id/btnConf"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="настройки"
            android:background="@drawable/btn_menu_dark"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

</RelativeLayout>